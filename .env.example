# Copy to .env.local (untracked). The default local demo needs no API keys.

# Local TTS (Piper)
# Executable name or full path. For the pip package use: python -m piper
PIPER_BIN=piper
# Path to the downloaded voice model (.onnx). Check the voice's license first.
PIPER_MODEL=models/en_US-lessac-medium.onnx

# Optional, only for the later ElevenLabs comparison (not used yet)
# ELEVENLABS_API_KEY=
